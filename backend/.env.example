# ==========================================
# CURA Backend & Edge AI Configuration
# ==========================================

# Application Settings
APP_NAME=CURA-Backend
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Edge AI Service (Ollama / llama.cpp)
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL_NAME=qwen2.5:1.5b-instruct
WHISPER_CPP_PATH=/usr/local/bin/whisper-cli
WHISPER_MODEL_PATH=models/ggml-base-q5_0.bin
PIPER_TTS_PATH=/usr/local/bin/piper
PIPER_MODEL_PATH=models/ar_EG-standard-medium.onnx

# Memory Ceiling Limit (Raspberry Pi 4 4GB Target)
MAX_RAM_USAGE_MB=2800

# External APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
ENABLE_DUCKDUCKGO_SEARCH=true

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./cura_edge.db
# Production PostgreSQL: postgresql+asyncpg://cura_user:cura_pass@localhost:5432/cura_db
REDIS_URL=redis://localhost:6379/0

# Hardware Bridge (Mini CURA)
ENABLE_HARDWARE_MOCK=true
WS_HEARTBEAT_SECONDS=15
